{{!
    @template local_urlbulkedit/editor

    Table of links with editable settings, a bulk-fill toolbar and find & replace.

    Example context (json):
    {
        "actionurl": "https://example.com/local/urlbulkedit/index.php",
        "courseid": 2,
        "sesskey": "abc",
        "hasrows": true,
        "popup": 6,
        "printintrodisplays": "0,1,2",
        "allchoices": [{"value": "5", "label": "Same as Unit 1 notes"}],
        "defaultcolumns": "externalurl,visible",
        "groups": [{"label": "General", "columns": [{"field": "visible", "label": "Visibility", "checked": true}]}],
        "filter": "",
        "fields": [
            {"field": "externalurl", "label": "URL", "hint": null, "isselect": false, "type": "text", "value": "", "isurl": true},
            {"field": "visible", "label": "Visibility", "hint": null, "isselect": true,
             "options": [{"value": "1", "label": "Shown", "selected": true}]}
        ],
        "rows": [{
            "urlid": 5, "name": "Unit 1 notes", "url": "#", "editurl": "#", "section": "Topic 1", "hidden": false,
            "externalurl": "https://example.com",
            "cells": [
                {"field": "externalurl", "isselect": false, "type": "text", "value": "https://example.com",
                 "original": "https://example.com", "changed": false, "error": null, "label": "URL: Unit 1 notes",
                 "isnumber": false, "isurl": true, "disabled": false, "note": null},
                {"field": "visible", "isselect": true, "original": "1", "changed": false, "error": null,
                 "label": "Visibility: Unit 1 notes", "disabled": false, "note": null,
                 "options": [{"value": "1", "label": "Shown", "selected": true}]}
            ]
        }]
    }
}}
{{^hasrows}}
    <p>{{#str}} nolinks, local_urlbulkedit {{/str}}</p>
{{/hasrows}}
{{#hasrows}}
<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
    <label for="local_urlbulkedit_filter" class="form-label mb-0">{{#str}} filter, local_urlbulkedit {{/str}}</label>
    <input type="search" id="local_urlbulkedit_filter" class="form-control w-auto" value="{{filter}}"
           data-action="filter" placeholder="{{#str}} filterplaceholder, local_urlbulkedit {{/str}}">
    <span class="text-muted small" data-region="filtercount" aria-live="polite"></span>
    <div class="form-check form-switch mb-0 ms-2">
        <input type="checkbox" class="form-check-input" id="local_urlbulkedit_changedonly" data-action="changedonly">
        <label for="local_urlbulkedit_changedonly" class="form-check-label">{{#str}} changedonly, local_urlbulkedit {{/str}}</label>
    </div>
    <div class="dropdown ms-auto">
        <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown"
                data-bs-auto-close="outside" aria-expanded="false" id="local_urlbulkedit_columnsbtn">
            {{#str}} columns, local_urlbulkedit {{/str}}
        </button>
        <div class="dropdown-menu dropdown-menu-end p-3 local-urlbulkedit-columns" aria-labelledby="local_urlbulkedit_columnsbtn"
             data-region="columns" data-default="{{defaultcolumns}}">
            {{#groups}}
            <fieldset class="mb-2">
                <legend class="fs-6 fw-bold mb-1">{{label}}</legend>
                {{#columns}}
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="local_urlbulkedit_col_{{field}}"
                           data-column="{{field}}"{{#checked}} checked{{/checked}}>
                    <label for="local_urlbulkedit_col_{{field}}" class="form-check-label">{{label}}</label>
                </div>
                {{/columns}}
            </fieldset>
            {{/groups}}
            <button type="button" class="btn btn-link btn-sm p-0" data-action="defaultcolumns">
                {{#str}} columnsdefault, local_urlbulkedit {{/str}}
            </button>
        </div>
    </div>
</div>
<form method="post" action="{{actionurl}}" id="local_urlbulkedit_form" data-region="local_urlbulkedit"
      data-popup="{{popup}}" data-printintrodisplays="{{printintrodisplays}}">
    <input type="hidden" name="id" value="{{courseid}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="filter" value="{{filter}}" data-region="filtervalue">

    <div class="d-flex flex-wrap gap-3 mb-3">
        <div class="card">
            <div class="card-body d-flex flex-wrap align-items-end gap-2">
                <div>
                    <label for="local_urlbulkedit_field" class="form-label mb-1">{{#str}} field, local_urlbulkedit {{/str}}</label>
                    <select id="local_urlbulkedit_field" class="form-select" data-action="bulkfield">
                        {{#fields}}
                            <option value="{{field}}"{{#colhidden}} hidden{{/colhidden}}>{{label}}</option>
                        {{/fields}}
                        <option value="all">{{#str}} allsettings, local_urlbulkedit {{/str}}</option>
                    </select>
                </div>
                <div>
                    <label class="form-label mb-1" data-region="bulkvaluelabel">{{#str}} value, local_urlbulkedit {{/str}}</label>
                    {{#fields}}
                        {{#isselect}}
                        <select id="local_urlbulkedit_value_{{field}}" class="form-select" data-bulkvalue="{{field}}" hidden>
                            {{#options}}<option value="{{value}}">{{label}}</option>{{/options}}
                        </select>
                        {{/isselect}}
                        {{^isselect}}
                        <input type="{{type}}" id="local_urlbulkedit_value_{{field}}" class="form-control" data-bulkvalue="{{field}}"
                               {{#isnumber}}min="1" step="1"{{/isnumber}}{{#isurl}} inputmode="url" size="40"{{/isurl}} hidden>
                        {{/isselect}}
                    {{/fields}}
                    <select id="local_urlbulkedit_value_all" class="form-select" data-bulkvalue="all" hidden>
                        {{#allchoices}}<option value="{{value}}">{{label}}</option>{{/allchoices}}
                    </select>
                </div>
                <button type="button" class="btn btn-secondary" data-action="bulkapply">
                    {{#str}} applytoselected, local_urlbulkedit {{/str}}
                </button>
            </div>
        </div>

        <div class="card">
            <div class="card-body d-flex flex-wrap align-items-end gap-2" data-region="replace">
                <div>
                    <label for="local_urlbulkedit_find" class="form-label mb-1">{{#str}} find, local_urlbulkedit {{/str}}</label>
                    <input type="text" id="local_urlbulkedit_find" class="form-control" data-region="find" size="24">
                </div>
                <div>
                    <label for="local_urlbulkedit_replacewith" class="form-label mb-1">{{#str}} replacewith, local_urlbulkedit {{/str}}</label>
                    <input type="text" id="local_urlbulkedit_replacewith" class="form-control" data-region="replacewith" size="24">
                </div>
                <div>
                    <label for="local_urlbulkedit_replacein" class="form-label mb-1">{{#str}} replacein, local_urlbulkedit {{/str}}</label>
                    <select id="local_urlbulkedit_replacein" class="form-select" data-region="replacein">
                        <option value="externalurl">{{#str}} replacein_urls, local_urlbulkedit {{/str}}</option>
                        <option value="name">{{#str}} replacein_names, local_urlbulkedit {{/str}}</option>
                    </select>
                </div>
                <button type="button" class="btn btn-secondary" data-action="replace">
                    {{#str}} replaceinselected, local_urlbulkedit {{/str}}
                </button>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle generaltable local-urlbulkedit-table">
            <thead>
                <tr>
                    <th scope="col" class="local-urlbulkedit-sticky1">
                        <input type="checkbox" class="form-check-input" data-action="selectall" id="local_urlbulkedit_all">
                        <label for="local_urlbulkedit_all" class="visually-hidden">{{#str}} selectall, local_urlbulkedit {{/str}}</label>
                    </th>
                    <th scope="col" class="local-urlbulkedit-sticky2">{{#str}} link, local_urlbulkedit {{/str}}</th>
                    {{#fields}}
                    <th scope="col" data-col="{{field}}" data-label="{{label}}"{{#colhidden}} hidden{{/colhidden}}>
                        {{label}}
                        {{#hint}}<div class="small fw-normal text-muted">{{.}}</div>{{/hint}}
                    </th>
                    {{/fields}}
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                <tr data-urlid="{{urlid}}" data-search="{{name}} {{section}} {{externalurl}}">
                    <td class="local-urlbulkedit-sticky1">
                        <input type="checkbox" class="form-check-input" data-action="select" id="local_urlbulkedit_sel{{urlid}}">
                        <label for="local_urlbulkedit_sel{{urlid}}" class="visually-hidden">{{#str}} select, local_urlbulkedit, {{name}} {{/str}}</label>
                    </td>
                    <td class="local-urlbulkedit-sticky2">
                        <a href="{{url}}" class="{{#hidden}}text-muted{{/hidden}}" data-region="linkname">{{name}}</a>
                        <a href="{{editurl}}" class="ms-1" title="{{#str}} editsettings, local_urlbulkedit, {{name}} {{/str}}"
                           aria-label="{{#str}} editsettings, local_urlbulkedit, {{name}} {{/str}}">{{#pix}} i/settings, core {{/pix}}</a>
                        <div class="small text-muted">{{section}}</div>
                    </td>
                    {{#cells}}
                    <td class="{{#changed}}table-warning{{/changed}}" data-cell="{{field}}" data-col="{{field}}"{{#colhidden}} hidden{{/colhidden}}>
                        <input type="hidden" name="o[{{urlid}}][{{field}}]" value="{{original}}">
                        <label for="local_urlbulkedit_{{urlid}}_{{field}}" class="visually-hidden">{{label}}</label>
                        {{#isselect}}
                        <select name="q[{{urlid}}][{{field}}]" id="local_urlbulkedit_{{urlid}}_{{field}}"
                                class="form-select form-select-sm{{#error}} is-invalid{{/error}}"
                                data-field="{{field}}" data-original="{{original}}"
                                {{#disabled}}disabled data-locked="1"{{/disabled}} {{#error}}aria-invalid="true"{{/error}}>
                            {{#options}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/options}}
                        </select>
                        {{/isselect}}
                        {{^isselect}}
                        <input type="{{type}}" name="q[{{urlid}}][{{field}}]" value="{{value}}"
                               id="local_urlbulkedit_{{urlid}}_{{field}}"
                               class="form-control form-control-sm{{#error}} is-invalid{{/error}}{{#isurl}} local-urlbulkedit-url{{/isurl}}"
                               data-field="{{field}}" data-original="{{original}}"
                               {{#isnumber}}min="1" step="1" style="width: 6em"{{/isnumber}}{{#isurl}} inputmode="url"{{/isurl}}
                               {{#disabled}}disabled data-locked="1"{{/disabled}} {{#error}}aria-invalid="true"{{/error}}>
                        {{/isselect}}
                        {{#note}}<div class="small text-muted">{{.}}</div>{{/note}}
                        {{#error}}<div class="invalid-feedback">{{.}}</div>{{/error}}
                    </td>
                    {{/cells}}
                </tr>
                {{/rows}}
            </tbody>
        </table>
    </div>

    <button type="submit" class="btn btn-primary">{{#str}} savechanges, local_urlbulkedit {{/str}}</button>
</form>
{{#js}}
    require(['local_urlbulkedit/editor'], function(editor) {
        editor.init('local_urlbulkedit_form');
    });
{{/js}}
{{/hasrows}}
